# local asks the model endpoint. evolus calls POST /api/v1/ai-tools/translate/run.
TRANSLATE_BACKEND=local
EVOLUS_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_LIBRARY_ID=
DATABASE_URL=sqlite:///./linelock.db
